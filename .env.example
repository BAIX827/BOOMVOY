# Frontend: keep the default same-origin /api gateway, or use a trusted HTTPS backend.
VITE_BOOMVOY_API_URL=/api

# Server only: copy the settings you need to .env.server. Never prefix secrets with VITE_.
GOOGLE_PLACES_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# auto: strict schema for supported OpenAI models; JSON mode for compatible gateways.
# Set json_schema or json_object explicitly for your provider; no probing/retry calls.
OPENAI_RESPONSE_FORMAT=auto
# Successful normalized AI results only, memory only; 0 disables reuse (max 3600000).
BOOMVOY_AI_CACHE_TTL_MS=600000

# Optional single-user versioned backup. Token: 32-512 UTF-8 bytes, no whitespace.
BOOMVOY_SYNC_TOKEN=
BOOMVOY_DATA_FILE=server/data/snapshot.json

# Backend protection and deployment allowlists.
BOOMVOY_PORT=8787
BOOMVOY_ALLOWED_ORIGINS=
BOOMVOY_ALLOWED_HOSTS=
BOOMVOY_CLIENT_RATE_LIMIT=30
BOOMVOY_SYNC_CONCURRENCY=4
BOOMVOY_UPSTREAM_CONCURRENCY=4
BOOMVOY_UPSTREAM_CALLS_PER_MINUTE=60

# Maps do not need a key:
# - tiles: OpenStreetMap
# - geocoding: Photon + Nominatim
# - driving/walk/cycle routes: public OSRM
# Transit uses a Google Maps link. Optional later: Mapbox or Google Directions if you want paid transit routing.
