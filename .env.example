VITE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Optional live hotel/restaurant decisions. Copy this server-only setting to .env.server.
# Never prefix the Google server key with VITE_. See DECISION_SETUP.md before enabling billing.
GOOGLE_PLACES_API_KEY=

# Maps do not need a key:
# - tiles: OpenStreetMap
# - geocoding: Photon + Nominatim
# - driving/walk/cycle routes: public OSRM
# Transit uses a Google Maps link. Optional later: Mapbox or Google Directions if you want paid transit routing.
